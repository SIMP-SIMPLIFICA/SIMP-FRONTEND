# URL base do Backend (API)
# Se estiver rodando o backend localmente, geralmente é http://localhost:3000
# Em produção, coloque a URL do servidor real (ex: https://api.seusistema.com.br)
VITE_API_URL=http://localhost:3000
# Cloudflare Turnstile — site key PUBLICA (anti-bot invisivel)
# A chave secreta correspondente vai no backend, em TURNSTILE_SECRET_KEY.
# Deixar vazio DESLIGA o widget: os formularios de Login e Esqueci a Senha
# seguem funcionando normalmente, espelhando o comportamento do backend.
VITE_TURNSTILE_SITE_KEY=

# Chaves de TESTE da Cloudflare:
#   sempre passa:            1x00000000000000000000AA
#   sempre falha:            2x00000000000000000000AB
#   forca desafio interativo: 3x00000000000000000000FF
